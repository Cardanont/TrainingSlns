@using OptcgExplorer.Core.Entities
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@if (IsVisible && Card is not null)
{
    <div class="modal-backdrop" @onclick="Close">

        <div class="modal-container" @onclick:stopPropagation="true">

            <button class="modal-close" @onclick="Close">
                <span class="modal-close-icon">✕</span>
            </button>

            <!-- Hero: card image — the star of the show -->
            <div class="modal-card-hero">
                <div class="modal-card-glow"
                     style="--glow-color: var(--card-color-@(Card.CardColor?.ToLower() ?? "default"))">
                </div>
                <div class="modal-image-wrap">
                    <img src="@Card.CardImage"
                         alt="@Card.CardName"
                         class="modal-image" />
                    <div class="modal-image-shine"></div>
                </div>
                <span class="modal-rarity-badge">@Card.Rarity</span>
            </div>

            <!-- Details panel below the card -->
            <div class="modal-details-panel">

                <div class="modal-meta">
                    <span class="modal-set-id-badge">@Card.SetId</span>
                    <span class="modal-card-id-badge">@Card.CardSetId</span>
                </div>

                <h3 class="modal-card-name">@Card.CardName</h3>
                <p class="modal-set-name">@Card.SetName</p>

                <div class="modal-divider"></div>

                <div class="modal-stats-row">
                    <div class="modal-stat-chip">
                        <span class="modal-stat-chip-label">Type</span>
                        <span class="modal-stat-chip-value modal-stat-chip-value--type">@Card.CardType</span>
                    </div>
                    <div class="modal-stat-chip">
                        <span class="modal-stat-chip-label">Color</span>
                        <span class="modal-stat-chip-value">
                            <span class="modal-color-dot"
                                  style="background:var(--card-color-@(Card.CardColor?.ToLower() ?? "default"))">
                            </span>
                            @Card.CardColor
                        </span>
                    </div>
                    <div class="modal-stat-chip">
                        <span class="modal-stat-chip-label">Rarity</span>
                        <span class="modal-stat-chip-value">@Card.Rarity</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Card.CardText))
                {
                    <div class="modal-divider"></div>
                    <div class="modal-card-text">
                        <span class="modal-card-text-label">Card Text</span>
                        <p class="modal-card-text-body">@Card.CardText</p>
                    </div>
                }

                <a href="/cards/@Card.SetId" class="modal-cta">
                    View Full Details <span class="modal-cta-arrow">→</span>
                </a>

            </div>

        </div>

    </div>
}



@code {
    [Parameter]
    public Card? Card { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

}
