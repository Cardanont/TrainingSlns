@page "/cards"
@page "/cards/{SetId}"
@using Microsoft.AspNetCore.Components.Web
@using OptcgExplorer.Core.Entities
@using OptcgExplorer.UseCases.Features.Cards.GetAllSetCards
@using OptcgExplorer.UseCases.Features.Cards.GetCardsBySetId
@using OptcgExplorer.Web.Components.Features.Cards.Components
@inject GetAllSetCardsHandler GetAllSetCardsHandler
@inject GetCardsBySetIdHandler GetCardsBySetIdHandler

<PageTitle>Sets Card — Grand Card Line</PageTitle>

<div class="cards-page">


    

    <div class="cards-hero">
        <div class="cards-hero-bg"></div>
        <div class="cards-hero-content">
            <span class="cards-eyebrow">
                <span class="cards-eyebrow-line"></span>
                OPTCG API
                <span class="cards-eyebrow-line"></span>
            </span>
            @if(SetId is null)
            {
                <h1 class="cards-title">All Sets Cards</h1>
            }
            else
            {
                <h1 class="cards-title">Set Cards</h1>
            }
            <p class="cards-subtitle">Browse every official release — from OP-01 Romance Dawn to the latest expansion.</p>
        </div>
    </div>

    <div class="cards-container">
        @if (_cards is null)
        {
            <div class="cards-loading">
                <div class="cards-loading-skull">☠</div>
                <p>Charting the seas…</p>
            </div>
        }
        else
        {

            <div class="cards-count-bar">
                <span class="cards-count-label">
                    <span class="cards-count-number">@_cards.Count()</span> cards found
                </span>
                <span class="cards-count-divider"></span>
                <span class="cards-count-hint">One Piece Trading Card Game · English release</span>
            </div>

            <div class="cards-grid">
                @foreach (var card in _cards)
                {
                    @* <div class="card-item" @onclick="() => ShowCardDetails(card)">
                        <div class="card-item-glow"></div>

                        <div class="card-item-image-wrap">
                            <img src="@card.CardImage" class="card-item-image" alt="@card.CardName" />
                            <div class="card-item-image-overlay"></div>
                            <span class="card-item-rarity">@card.Rarity</span>
                        </div>

                        <div class="card-item-body">
                            <div class="card-item-meta">
                                <span class="card-item-set-id">@card.SetId</span>
                                <span class="card-item-card-id">@card.CardSetId</span>
                            </div>

                            <h3 class="card-item-name">@card.CardName</h3>
                            <p class="card-item-set-name">@card.SetName</p>

                            <div class="card-item-tags">
                                <span class="card-tag card-tag--color">
                                    <span class="card-tag-dot" style="background: var(--card-color-@(card.CardColor?.ToLower() ?? "default"))"></span>
                                    @card.CardColor
                                </span>
                                <span class="card-tag card-tag--type">@card.CardType</span>
                            </div>
                            
                        </div>
                    </div> *@
                    @* <TestComponent/> *@


                    <CardItem
                        Card ="card"
                        OnSelected="ShowCardDetails" />
                }
            </div>
        }
    </div>

</div>

<CardDetailsModal
    Card ="_selectedCard"
    IsVisible = "_showModal"
    OnClose="CloseModal" />


@code {

    [Parameter]
    public string? SetId { get; set; }
    private IReadOnlyCollection<Card> _cards = [];
    private Card? _selectedCard;
    private bool _showModal;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(SetId))
        {
            var reuslt = await GetAllSetCardsHandler.HandleAsync(
                new GetAllSetCardsQuery()
            );

            _cards = reuslt.Cards;
        }
        else
        {
            var result = await GetCardsBySetIdHandler.HandleAsync(
            new GetCardsBySetIdQuery(SetId));

            _cards = result.Cards;
        }

    }

    private void ShowCardDetails(Card card)
    {
        _selectedCard = card;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _selectedCard = null;
    }

}
