@if (IsVisible && DonCard is not null)
{
    <div class="modal-backdrop" @onclick="Close">

        <div class="modal-container" @onclick:stopPropagation="true">

            <button class="modal-close" @onclick="Close">
                <span class="modal-close-icon">✕</span>
            </button>

            <!-- Hero: card image — the star of the show -->
            <div class="modal-card-hero">
                <div class="modal-image-wrap">
                    @if (!string.IsNullOrWhiteSpace(DonCard.CardImage))
                    {
                        <img src="@DonCard.CardImage"
                             alt="@DonCard.CardName"
                             class="modal-image" />
                    }
                    else
                    {
                        <div class="modal-image-placeholder">
                            No Image Available
                        </div>
                    }
                    <div class="modal-image-shine"></div>
                </div>
                <span class="modal-rarity-badge">@DonCard.Rarity</span>
            </div>

            <!-- Details panel below the card -->
            <div class="modal-details-panel">

                <div class="modal-meta">
                    @* <span class="modal-set-id-badge">@DonCard.DonId</span> *@
                    <span class="modal-card-id-badge">@DonCard.CardType</span>
                </div>

                <h3 class="modal-card-name">@DonCard.CardName</h3>
                <p class="modal-set-name">@DonCard.OptcgDonName</p>

                <div class="modal-divider"></div>

                <div class="modal-stats-row">
                    <div class="modal-stat-chip">
                        <span class="modal-stat-chip-label">Type</span>
                        <span class="modal-stat-chip-value modal-stat-chip-value--type">@DonCard.CardType</span>
                    </div>
                    <div class="modal-stat-chip">
                        <span class="modal-stat-chip-label">Rarity</span>
                        <span class="modal-stat-chip-value">@DonCard.Rarity</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(DonCard.CardText))
                {
                    <div class="modal-divider"></div>
                    <div class="modal-card-text">
                        <span class="modal-card-text-label">Card Text</span>
                        <p class="modal-card-text-body">@DonCard.CardText</p>
                    </div>
                }

                @* <a href="/cards/@DonCard.DonId" class="modal-cta">
                    View Full Details <span class="modal-cta-arrow">→</span>
                </a> *@

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public DonCard? DonCard { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

}
